# Environments, credentials and local configuration
.venv*/
venv/
.env
.env.*
!.env.example

# Python, notebooks and editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.DS_Store
~$*

# Supplied assignment materials: decide sharing separately from source code
/KEP_2026.json
/Take-Home_Exercise.docx
/unpack_data.ipynb

# Historical duplicate notebook and generated HTML export
/task1_memory.ipynb
/task2_evaluation.html
/COMMIT_PLAN.md
/take-home-exercise.bundle

# Keep generated runs local except for the selected memory and final evaluation.
/artifacts/*
