# Copy to .env and fill locally. Offline remains the reproducible default.
MEMORY_MODE=offline
# compatible uses API credentials; codex reuses your ChatGPT subscription login.
MEMORY_PROVIDER=compatible
MEMORY_BASE_URL=https://api.openai.com/v1
# Blank selects gpt-4.1-mini-2025-04-14 (compatible) or gpt-5.6-luna (codex).
# Set gpt-6-sol to use Sol with Codex. CLI --model overrides this value.
MEMORY_MODEL=
MEMORY_API_KEY=
# OPENAI_API_KEY is accepted when MEMORY_API_KEY is empty.
MEMORY_AUTH_HEADER=Authorization
MEMORY_AUTH_PREFIX=Bearer
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Dense recall is available only with compatible and uses additional calls.
MEMORY_USE_DENSE=0
# Use json_object for compatible providers without strict JSON Schema support.
MEMORY_RESPONSE_FORMAT=json_schema
# Hosted mode reviews ALL eligible candidates before applying retention.
# 816 fixed candidates / 6 per batch = 136 nominal initial judge requests.
# Size reductions and one correction of unresolved IDs can require more.
MEMORY_MAX_CALLS=200
MEMORY_REVIEW_BATCH_SIZE=6
MEMORY_MAX_PATTERN_CALLS=0
# Hosted patterns are deferred; the above setting remains for CLI compatibility.
# Whole candidate packets are never truncated. Oversized batches split; an oversized
# singleton stops with a checkpoint. Increase only within your model's capacity.
MEMORY_MAX_PACKET_CHARS=100000
# Blank selects 60 seconds for compatible, 300 seconds for codex.
MEMORY_TIMEOUT_SECONDS=
MEMORY_CODEX_REASONING_EFFORT=medium
# Optional absolute Codex executable path; blank uses the SDK's pinned runtime.
MEMORY_CODEX_BIN=
# Reuse this directory to resume validated judgments. Rejected responses are audited.
MEMORY_CACHE_DIR=artifacts/cache
# Hosted review can take longer than a notebook's normal per-cell deadline.
MEMORY_NOTEBOOK_CELL_TIMEOUT=1800
# Optional explicit prices; unknown prices remain null instead of guessed.
# MEMORY_INPUT_USD_PER_MILLION=
# MEMORY_OUTPUT_USD_PER_MILLION=
